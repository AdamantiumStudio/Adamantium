<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <Platforms>AnyCPU</Platforms>
        <Configurations>Debug;Release</Configurations>
        <LangVersion>latestmajor</LangVersion>
        <IsPackable>true</IsPackable>
        <Description>Reads TrueType, OpenType and CFF fonts - outlines, metrics, kerning and OpenType features - and generates multichannel signed distance field (MSDF) glyph atlases.</Description>
        <PackageTags>adamantium;fonts;opentype;truetype;cff;msdf</PackageTags>
    </PropertyGroup>

    <ItemGroup>
      <None Remove="atomicage-regular.ttf" />
      <None Remove="azoft-sans.ttf" />
      <None Remove="PlayfairDisplay-Regular.ttf" />
      <None Remove="Windsong.ttf" />
      <None Remove="OTFFonts\Poppins-Medium.otf" />
      <None Remove="OTFFonts\Glametrix-oj9A.otf" />
      <None Remove="obj\**" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Adamantium.Mathematics\Adamantium.Mathematics.csproj" />
    </ItemGroup>

    <ItemGroup>
      <InternalsVisibleTo Include="Adamantium.FontTests" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="BrotliSharpLib" Version="0.3.3" />
      <PackageReference Include="SharpZipLib" Version="1.4.2" />
    </ItemGroup>

    <ItemGroup>
      <Compile Remove="obj\**" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Remove="obj\**" />
      <EmbeddedResource Include="Data\*.ucd;Data\*.dat" />
    </ItemGroup>

</Project>
